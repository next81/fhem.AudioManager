#!/usr/bin/env perl

use strict;
use warnings;
use FindBin qw($RealBin);
use File::Spec ();

my $root = File::Spec->rel2abs(
	File::Spec->catdir($RealBin, File::Spec->updir),
);
chdir $root or die "Kann nicht in das Projektverzeichnis $root wechseln: $!\n";

my $generator = File::Spec->catfile('tools', 'generate_controls.pl');
system($^X, $generator) == 0
	or die "Erzeugen von controls_AudioManager.txt fehlgeschlagen.\n";

system('git', 'add', '--', 'controls_AudioManager.txt') == 0
	or die "Staging von controls_AudioManager.txt fehlgeschlagen.\n";


subtest 'all erweitert eine laufende Stream-Baseline nur um neue Gruppen' => sub {
	reset_env();
	add_sonos('Sonos.A', 'uuid-a');
	add_sonos('Sonos.B', 'uuid-b', 'uuid-a');
	add_sonos(
		'Sonos.C', 'uuid-c', undef,
		transportState => 'PLAYING', uri => 'http://extern/tv.mp3',
	);
	my ($hash, $error) = define_manager('Audio', 'sonos2mqtt=Sonos.A,Sonos.B,Sonos.C');
	is($error, undef, 'Manager fuer Radio- und externe Standalone-Gruppe wird definiert');
	is(
		main::AudioManager_Set(
			$hash, 'Audio', 'stream', 'target=group:Sonos.A', 'Antenne.Muenster',
		),
		undef,
		'Radio startet nur in der vorhandenen Zweiergruppe',
	);
	is(
		main::AudioManager_Set($hash, 'Audio', 'play', 'volume=40', 'http://fhem/gong.mp3'),
		undef,
		'all-Gong unterbricht das Radio und erreicht die Standalone-Gruppe',
	);
	my $baselines = $hash->{helper}{baselines}{sonos2mqtt};
	is(scalar(@$baselines), 2, 'neue Standalone-Gruppe erhaelt eine eigene Baseline');
	is(
		[ sort map { @{ $_->{snapshot}{scope} } } @$baselines ],
		[qw(Sonos.A Sonos.B Sonos.C)],
		'jede physische Ressource ist genau durch die Baselines abgedeckt',
	);
	main::AudioManager_Worker($hash);
	set_reading('Sonos.A', 'transportState', 'STOPPED');
	set_reading('Sonos.C', 'transportState', 'STOPPED');
	advance_time(3);
	main::AudioManager_Worker($hash);
	ok(
		grep($_ eq 'set Sonos.A playFav Antenne.Muenster', @{ command_log() }),
		'Radio wird aus seinem Streamauftrag fortgesetzt',
	);
	ok(
		grep($_ eq 'set Sonos.C playUri http://extern/tv.mp3', @{ command_log() }),
		'externe Quelle der zusaetzlich beruehrten Gruppe wird restauriert',
	);
};

subtest 'periodische ZoneInfo-Probes reparieren ausgefallene Player ohne externe Watcher' => sub {
	reset_env();
	add_sonos('Sonos.A', 'uuid-a');
	add_sonos('Sonos.B', 'uuid-b');
	$main::attr{Audio}{healthDebounce} = 0;
	$main::attr{Audio}{healthVerifyTimeout} = 5;
	$main::attr{Audio}{healthRecoveryCooldown} = 0;
	$main::attr{Audio}{healthProbeInterval} = 1;
	my ($hash, $error) = define_manager('Audio', 'sonos2mqtt=Sonos.A,Sonos.B');
	is($error, undef, 'Manager wird ohne Bridge und readingsWatcher definiert');
	is(reading_value('Audio', 'backendHealth'), 'sonos2mqtt:healthy', 'Backend startet ohne bekannten Fehler');
	is(reading_value('Audio', 'backendHealthError'), 'none', 'ohne Ausfall besteht kein aktueller Healthfehler');
	is(scalar(@{ timers() }), 1, 'ein Langzeittimer plant den ersten Probe');
	run_next_timer();
	is(
		scalar(grep(/GetZoneInfo/, @{ command_log() })),
		2,
		'erster Probe fragt jeden verwalteten Player direkt ab',
	);
	is(reading_value('Audio', 'backendHealth'), 'sonos2mqtt:verifying', 'Probe wartet auf direkte Antworten');

	set_reading('Sonos.A', 'IPAddress', '192.168.1.11');
	$main::defs{'Sonos.A'}{CHANGED} = ['IPAddress: 192.168.1.11'];
	main::AudioManager_Notify($hash, $main::defs{'Sonos.A'});
	set_reading('Sonos.B', 'IPAddress', '192.168.1.12');
	$main::defs{'Sonos.B'}{CHANGED} = ['IPAddress: 192.168.1.12'];
	main::AudioManager_Notify($hash, $main::defs{'Sonos.B'});
	run_next_timer();
	is(reading_value('Audio', 'backendHealth'), 'sonos2mqtt:healthy', 'beide ZoneInfo-Antworten bestaetigen den Probe');
	is(reading_value('Audio', 'backendRecoveryCount'), 0, 'Routineprobe wird nicht als Recovery gezaehlt');
	is(scalar(@{ timers() }), 1, 'danach bleibt nur der naechste Langzeittermin');

	@AudioManagerTestEnv::COMMAND_LOG = ();
	run_next_timer();
	set_reading('Sonos.A', 'IPAddress', '192.168.1.11');
	$main::defs{'Sonos.A'}{CHANGED} = ['IPAddress: 192.168.1.11'];
	main::AudioManager_Notify($hash, $main::defs{'Sonos.A'});
	run_next_timer();
	run_next_timer();
	is(
		[grep(/^publish /, @{ command_log() })],
		['publish Sonos.A sonos/cmd/check-subscriptions'],
		'fehlende Antwort loest genau einen globalen Subscription-Refresh aus',
	);
	is(reading_value('Audio', 'backendRecoveryCount'), 1, 'nur der Reparaturversuch wird gezaehlt');
	is(
		scalar(grep(/Sonos.B x_raw_payload.*GetZoneInfo/, @{ command_log() })),
		2,
		'fehlender Player wurde einmal regulaer und einmal nach Recovery geprueft',
	);
	is(
		scalar(grep { $_->{message} =~ /Player offline: Sonos\.B/ } @{ log_messages() }),
		0,
		'waehrend des ersten Reparaturversuchs wird noch kein Offlinefehler geloggt',
	);

	run_next_timer();
	is(reading_value('Audio', 'backendHealth'), 'sonos2mqtt:degraded', 'unbeantworteter Wiederholungsprobe degradiert das Backend');
	is(
		reading_value('Audio', 'backendHealthError'),
		'sonos2mqtt: Player offline: Sonos.B',
		'das aktuelle Error-Reading nennt den ausgefallenen Player',
	);
	my @offline_logs = grep { $_->{message} =~ /Player offline: Sonos\.B/ } @{ log_messages() };
	is(scalar(@offline_logs), 1, 'der endgueltige Offlinezustand wird genau einmal geloggt');
	is($offline_logs[0]{level}, 2, 'der Offlinezustand verwendet Log-Level 2');
	main::AudioManager_update_health($hash);
	is(
		scalar(grep { $_->{message} =~ /Player offline: Sonos\.B/ } @{ log_messages() }),
		1,
		'unveraenderter Offlinezustand erzeugt keinen weiteren Logeintrag',
	);

	run_next_timer();
	set_reading('Sonos.A', 'IPAddress', '192.168.1.11');
	$main::defs{'Sonos.A'}{CHANGED} = ['IPAddress: 192.168.1.11'];
	main::AudioManager_Notify($hash, $main::defs{'Sonos.A'});
	set_reading('Sonos.B', 'IPAddress', '192.168.1.12');
	$main::defs{'Sonos.B'}{CHANGED} = ['IPAddress: 192.168.1.12'];
	main::AudioManager_Notify($hash, $main::defs{'Sonos.B'});
	run_next_timer();
	advance_time(0.1);
	set_reading('Sonos.B', 'IPAddress', '192.168.1.12');
	$main::defs{'Sonos.B'}{CHANGED} = ['IPAddress: 192.168.1.12'];
	main::AudioManager_Notify($hash, $main::defs{'Sonos.B'});
	run_next_timer();
	is(reading_value('Audio', 'backendHealth'), 'sonos2mqtt:healthy', 'Antwort des wiedergekehrten Players bestaetigt die Recovery');
	is(reading_value('Audio', 'backendHealthError'), 'none', 'bestaetigte Wiederkehr loescht den aktuellen Healthfehler');
	my @recovery_logs = grep { $_->{message} =~ /Backend sonos2mqtt wieder erreichbar/ } @{ log_messages() };
	is(scalar(@recovery_logs), 1, 'die bestaetigte Wiederkehr wird genau einmal geloggt');
	is($recovery_logs[0]{level}, 3, 'die Entwarnung verwendet Log-Level 3');
	my $health = JSON::PP::decode_json(main::AudioManager_Get($hash, 'Audio', 'health'));
	is($health->{sonos2mqtt}{details}{players}{'Sonos.B'}{status}, 'reachable', 'Get health zeigt den Player wieder erreichbar');
};

subtest 'Bridge-Availability wird automatisch erkannt und kann explizit ueberschrieben werden' => sub {
	reset_env();
	add_sonos('Sonos.A', 'uuid-a');
	add_bridge('Sonos.Bridge', 'sonos', 0);
	$main::attr{Audio}{healthDebounce} = 0;
	$main::attr{Audio}{healthProbeInterval} = 10;
	my ($hash, $error) = define_manager('Audio', 'sonos2mqtt=Sonos.A');
	is($error, undef, 'Manager wird mit vorhandener Bridgezuordnung definiert');
	is($hash->{NOTIFYDEV}, 'Sonos.A,Sonos.Bridge,global', 'Autoerkennung nimmt nur das Availability-Device hinzu');
	my $health = JSON::PP::decode_json(main::AudioManager_Get($hash, 'Audio', 'health'));
	is($health->{sonos2mqtt}{details}{availability}{mode}, 'auto', 'exakte Topiczuordnung wurde automatisch erkannt');
	is($health->{sonos2mqtt}{details}{availability}{status}, '0', 'connected=0 ist als Bridgezustand sichtbar');
	$main::defs{'Sonos.Bridge'}{CHANGED} = ['connected: 0'];
	main::AudioManager_Notify($hash, $main::defs{'Sonos.Bridge'});
	is(reading_value('Audio', 'backendHealth'), 'sonos2mqtt:degraded', 'Bridge-Offlineevent degradiert das Backend sofort');
	set_reading('Sonos.Bridge', 'connected', 2);
	$main::defs{'Sonos.Bridge'}{CHANGED} = ['connected: 2'];
	main::AudioManager_Notify($hash, $main::defs{'Sonos.Bridge'});
	run_next_timer();
	ok(grep(/GetZoneInfo/, @{ command_log() }), 'connected=2 startet sofort einen Playerprobe');

	add_bridge('Custom.Bridge', 'custom', 2);
	is(
		main::AudioManager_Attr('set', 'Audio', 'backendAvailability', 'sonos=Custom.Bridge:connected'),
		undef,
		'manuelle Zuordnung wird live uebernommen',
	);
	is($hash->{NOTIFYDEV}, 'Custom.Bridge,Sonos.A,global', 'manuelle Zuordnung ersetzt die automatisch erkannte Bridge');
	$health = JSON::PP::decode_json(main::AudioManager_Get($hash, 'Audio', 'health'));
	is($health->{sonos2mqtt}{details}{availability}{mode}, 'configured', 'manueller Modus bleibt diagnostizierbar');
	is($health->{sonos2mqtt}{details}{availability}{device}, 'Custom.Bridge', 'konfiguriertes Device bleibt sichtbar');
};
subtest 'Mute stellt individuelle Zustaende wieder her und Force entmutet unabhaengig' => sub {
	reset_env();
	add_sonos('Sonos.A', 'uuid-a', undef, mute => 'false');
	add_sonos('Sonos.B', 'uuid-b', undef, mute => 'true');
	my ($hash, $error) = define_manager('Audio', 'sonos2mqtt=Sonos.A,Sonos.B');
	is($error, undef, 'Manager fuer Mute-Tests wird definiert');

	is(
		main::AudioManager_Set($hash, 'Audio', 'mute', 'target=player:Sonos.A', 'on'),
		undef,
		'erster Zielplayer wird gemutet',
	);
	is($hash->{helper}{mute_snapshot}, { 'Sonos.A' => 'false' }, 'erster Zustand wird gesichert');
	is(
		main::AudioManager_Set($hash, 'Audio', 'mute', 'on'),
		undef,
		'ueberlappender Aufruf erweitert die laufende Mute-Phase',
	);
	is(
		$hash->{helper}{mute_snapshot},
		{ 'Sonos.A' => 'false', 'Sonos.B' => 'true' },
		'bereits gesicherter Zustand bleibt erhalten und der zweite Player kommt hinzu',
	);
	is(reading_value('Sonos.A', 'mute'), 'true', 'zuvor offener Player ist gemutet');
	is(reading_value('Sonos.B', 'mute'), 'true', 'bereits gemuteter Player bleibt gemutet');

	is(
		main::AudioManager_Set($hash, 'Audio', 'mute', 'target=player:Sonos.A', 'off'),
		undef,
		'Teilziel wird auf seinen Zustand vor der Mute-Phase zurueckgesetzt',
	);
	is(reading_value('Sonos.A', 'mute'), 'false', 'erster Player wird wieder entmutet');
	is(reading_value('Sonos.B', 'mute'), 'true', 'nicht ausgewaehlter Player bleibt gemutet');
	is($hash->{helper}{mute_snapshot}, { 'Sonos.B' => 'true' }, 'nur der offene Snapshot bleibt erhalten');
	is(main::AudioManager_Set($hash, 'Audio', 'mute', 'off'), undef, 'restliche Mute-Phase wird beendet');
	is(reading_value('Sonos.B', 'mute'), 'true', 'urspruenglich gemuteter Player wird nicht entmutet');
	is($hash->{helper}{mute_snapshot}, {}, 'vollstaendig restaurierte Phase ist vergessen');

	set_reading('Sonos.A', 'mute', 'true');
	my $command_count = scalar @{ command_log() };
	is(
		main::AudioManager_Set($hash, 'Audio', 'mute', 'target=player:Sonos.A', 'off'),
		undef,
		'mute off ohne Snapshot bleibt ein sicherer No-op',
	);
	is(scalar(@{ command_log() }), $command_count, 'ohne Snapshot wird kein Unmute gesendet');
	is(reading_value('Sonos.A', 'mute'), 'true', 'fremd gemuteter Player bleibt unveraendert');
	is(
		main::AudioManager_Set($hash, 'Audio', 'mute', 'target=player:Sonos.A', 'off', 'force'),
		undef,
		'Force entmutet auch ohne vorherigen Snapshot',
	);
	is(reading_value('Sonos.A', 'mute'), 'false', 'Force hat den Player sicher entmutet');

	set_reading('Sonos.B', 'mute', 'true');
	is(main::AudioManager_Set($hash, 'Audio', 'mute', 'on'), undef, 'neue Mute-Phase wird gesichert');
	is(
		main::AudioManager_Set($hash, 'Audio', 'mute', 'off', 'force'),
		undef,
		'Force entmutet alle Ziele unabhaengig vom gespeicherten Zustand',
	);
	is(reading_value('Sonos.A', 'mute'), 'false', 'Force entmutet den ersten Player');
	is(reading_value('Sonos.B', 'mute'), 'false', 'Force entmutet auch den zuvor gemuteten Player');
	is($hash->{helper}{mute_snapshot}, {}, 'Force verwirft die verbrauchten Snapshoteintraege');
	like(
		main::AudioManager_Set($hash, 'Audio', 'mute', 'on', 'force'),
		qr/nur zusammen mit mute off/,
		'Force ist fuer mute on nicht zulaessig',
	);
	like(
		main::AudioManager_Set($hash, 'Audio', 'mute', 'force=1', 'off'),
		qr/Usage:/,
		'die alte Force-Key-Value-Form wird abgelehnt',
	);
	like(
		main::AudioManager_Set($hash, 'Audio', 'volume', '20', 'force'),
		qr/Usage:/,
		'Volume akzeptiert das Mute-spezifische Force-Flag nicht',
	);
};

subtest 'Medienreadings und FTUI-Steuerbefehle laufen ueber den Manager' => sub {
	reset_env();
	add_sonos(
		'Sonos.A', 'uuid-a', undef,
		transportState => 'PLAYING', volume => 10,
		title => 'Californication', legacyTitle => 'vogel06.mp3',
		artist => 'Red Hot Chili Peppers', legacyArtist => 'southstar',
		album => 'By the Way', albumArtUri => 'https://radio.example/logo.png',
		legacyAlbumArtUri => 'https://radio.example/old.png',
	);
	my ($hash, $error) = define_manager('Audio', 'sonos2mqtt=Sonos.A');
	is($error, undef, 'Manager fuer Medienreadings wird definiert');
	is(reading_value('Audio', 'mediaType'), 'none', 'ohne Managerauftrag ist keine Medienart aktiv');
	is(reading_value('Audio', 'title'), '', 'ohne Managerauftrag bleibt der Titel leer');
	is(
		main::AudioManager_Set(
			$hash, 'Audio', 'stream', 'target=group:Sonos.A', 'Radio.7.ULM',
		),
		undef,
		'Radiostream wird zentral gestartet',
	);
	is(reading_value('Audio', 'mediaType'), 'stream', 'Manager weist den aktiven Stream aus');
	is(reading_value('Audio', 'source'), 'Radio.7.ULM', 'Favoritenname wird als Quelle gespiegelt');
	is(reading_value('Audio', 'title'), 'Californication', 'aktuelles Titelreading wird gespiegelt');
	is(reading_value('Audio', 'artist'), 'Red Hot Chili Peppers', 'aktuelles Artistreading wird gespiegelt');
	is(reading_value('Audio', 'albumArtUri'), 'https://radio.example/logo.png', 'aktuelles Cover wird gespiegelt');
	is(reading_value('Audio', 'mediaPlayer'), 'Sonos.A', 'Coordinator bleibt diagnostizierbar');

	set_reading('Sonos.A', 'currentTrack_title', 'Under the Bridge');
	$main::defs{'Sonos.A'}{CHANGED} = ['currentTrack_title: Under the Bridge'];
	main::AudioManager_Notify($hash, $main::defs{'Sonos.A'});
	is(reading_value('Audio', 'title'), 'Under the Bridge', 'Notify aktualisiert den Managertitel sofort');
	is(
		main::AudioManager_Set(
			$hash, 'Audio', 'transport', 'target=group:Sonos.A', 'pause',
		),
		undef,
		'Pause wird ueber den Manager angenommen',
	);
	ok(grep($_ eq 'set Sonos.A pause', @{ command_log() }), 'Manager adressiert den Coordinator');
	is(reading_value('Audio', 'transportState'), 'PAUSED_PLAYBACK', 'Transportreading folgt der Pause');
	is(
		main::AudioManager_Set(
			$hash, 'Audio', 'volumeStep', 'target=player:Sonos.A', 'down',
		),
		undef,
		'Lautstaerkeschritt wird ueber den Manager angenommen',
	);
	is(reading_value('Sonos.A', 'volume'), 9, 'Zielplayer wurde um einen Schritt abgesenkt');
	is(
		main::AudioManager_Set($hash, 'Audio', 'stop', 'target=group:Sonos.A'),
		undef,
		'Stream wird zentral gestoppt',
	);
	is(reading_value('Audio', 'mediaType'), 'none', 'Stopp leert die aktive Medienart');
	is(reading_value('Audio', 'source'), 'none', 'Stopp leert die aktive Quelle');
	is(reading_value('Audio', 'title'), '', 'Stopp entfernt den vorherigen Titel');
};

done_testing;
